# local dev (compose.dev.yml)
POSTGRES_SUPERUSER_PASSWORD=postgres
APP_ADMIN_PASSWORD=app_admin

# admin app
DATABASE_URL_MAINTENANCE=postgres://app_admin:app_admin@localhost:5436/postgres
DATABASE_URL_META=postgres://app_admin:app_admin@localhost:5436/db_web_meta
BETTER_AUTH_SECRET=change-me-32-bytes-minimum-random-string
BETTER_AUTH_URL=http://localhost:3000

# optional: sidebar link to Databasus, and the host shown on the Connect page
BACKUPS_URL=http://localhost:4005
TAILSCALE_HOSTNAME=
